// 复制为 wrangler.jsonc 后按自己的账号填写。
//
//   cp wrangler.example.jsonc wrangler.jsonc
//   pnpm exec wrangler d1 create tidy-cookbook     # 把输出的 database_id 填进去
//   pnpm exec wrangler d1 execute tidy-cookbook --remote --file=./schema.sql
//   pnpm deploy
//
// wrangler.jsonc 不入库：里面的 database_id 和自定义域名是各自账号专属的。
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tidy-cookbook",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],

  // 自定义域名。可以删掉这行改用默认的 *.workers.dev，
  // 但 workers.dev 在中国大陆被 SNI 封锁，国内访问需要自有域名。
  "routes": [{ "pattern": "cook.example.com", "custom_domain": true }],

  // next build（output: 'export'）产出 ./out，整站静态。
  // 静态资源请求免费且不计入 Workers 的 100k/天配额。
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tidy-cookbook",
      "database_id": "在这里填 wrangler d1 create 返回的 uuid"
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "KITCHEN", "class_name": "KitchenDO" }]
  },

  // 免费版的 Durable Objects 必须用 SQLite 存储后端
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KitchenDO"] }],

  "observability": { "enabled": true }
}
