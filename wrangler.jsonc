{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tidy-cookbook",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],

  // \u81ea\u5b9a\u4e49\u57df\u540d\uff1a*.workers.dev \u5728\u56fd\u5185\u88ab SNI \u5c01\u9501\uff0c\u8d70\u81ea\u6709\u57df\u540d\u624d\u80fd\u76f4\u8fde\u3002
  // DNS \u8bb0\u5f55\u548c\u8bc1\u4e66\u7531 Cloudflare \u81ea\u52a8\u521b\u5efa\u5e76\u6c38\u4e45\u7eed\u671f\u3002
  "routes": [{ "pattern": "cook.ruiovo.com", "custom_domain": true }],

  // next build（output: 'export'）产出 ./out，整站静态
  // 静态资源请求免费且不计入 Workers 的 100k/天
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tidy-cookbook",
      "database_id": "87586f4d-ea44-4328-89d4-1af9a17e207f",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "KITCHEN", "class_name": "KitchenDO" }]
  },

  // 免费版的 Durable Objects 必须用 SQLite 存储后端
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KitchenDO"] }],

  // 每天 UTC 20:00 = 北京时间 04:00，清理过期的 op_seen 并广播新快照（今天变了，昨天的订单离开「待吃」），不碰点菜单
  "triggers": { "crons": ["0 20 * * *"] },

  "observability": { "enabled": true },

  // 试用环境：eat.ruiovo.com。独立 Worker + 独立 D1 + 独立 Durable Object，和自用的 cook 数据完全隔离。
  // 部署：pnpm build && pnpm exec wrangler deploy --env eat
  // 不配 BARK_URL（陌生人下单不推送）；TRIAL=1 让所有人都能改 / 删历史订单。
  "env": {
    "eat": {
      "name": "tidy-cookbook-eat",
      "routes": [{ "pattern": "eat.ruiovo.com", "custom_domain": true }],
      "vars": { "TRIAL": "1" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tidy-cookbook-eat",
          "database_id": "1d74e1c5-cd50-4d57-89bc-4d17934aeab4",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "KITCHEN", "class_name": "KitchenDO" }]
      },
      "triggers": { "crons": ["0 20 * * *"] }
    }
  }
}
